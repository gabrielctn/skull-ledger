# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
# Ignore the generated project contents rather than the ios/ directory itself,
# so the Xcode Cloud build scripts below stay tracked. Git cannot re-include a
# path whose parent directory is excluded.
ios/*
android/
# Xcode Cloud only runs build scripts that sit next to the Xcode project, so
# these live under ios/ even though the rest of it is generated by prebuild.
!ios/ci_scripts/
!native/ios/
!native/ios/**

# Metro
.metro-health-check*

# macOS
.DS_Store

# Env
.env*.local

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*

# Tooling
.superpowers/
.worktrees/
.playwright-cli/
output/playwright/

# Legacy native Xcode scaffold (superseded by the Expo project)
# Skull-King/
# Skull-King.xcodeproj/

# Planning docs and marketing assets are kept on disk but out of git.
docs/superpowers/
marketing/

# Database dumps contain players' game data.
supabase-backup-*.sql
